<Rive version="1" kind="fragment">
    <Artboard defaultStateMachineId="0:10" styleId="0:5" width="256" height="256" name="UnitNodeArtboard" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <Fill name="Background">
            <SolidColor colorValue="00000000" name="Transparent"/>
        </Fill>

        <StateMachine name="NodeState" id="0:10">
            <StateMachineNumber value="0" name="status" id="0:11"/>
            <StateMachineBool value="false" name="isPressed" id="0:12"/>

            <!-- Layer 1: Status (0=Locked, 1=Active, 2=Completed) -->
            <StateMachineLayer name="StatusLayer" id="0:20">
                <AnyState x="200" y="-120"/>
                <ExitState x="620" y="-120"/>
                <EntryState>
                    <StateTransition stateToId="0:21"/>
                </EntryState>

                <!-- 0: Locked -->
                <AnimationState x="160" y="40" animationId="0:30" id="0:21">
                    <StateTransition stateToId="0:22" duration="180">
                        <TransitionNumberCondition inputId="0:11" opValue="greaterThanOrEqual" value="1"/>
                        <TransitionNumberCondition inputId="0:11" opValue="lessThan" value="2"/>
                    </StateTransition>
                    <StateTransition stateToId="0:23" duration="180">
                        <TransitionNumberCondition inputId="0:11" opValue="greaterThanOrEqual" value="2"/>
                    </StateTransition>
                </AnimationState>

                <!-- 1: Active -->
                <AnimationState x="360" y="40" animationId="0:31" id="0:22">
                    <StateTransition stateToId="0:21" duration="180">
                        <TransitionNumberCondition inputId="0:11" opValue="lessThan" value="1"/>
                    </StateTransition>
                    <StateTransition stateToId="0:23" duration="180">
                        <TransitionNumberCondition inputId="0:11" opValue="greaterThanOrEqual" value="2"/>
                    </StateTransition>
                </AnimationState>

                <!-- 2: Completed -->
                <AnimationState x="560" y="40" animationId="0:32" id="0:23">
                    <StateTransition stateToId="0:21" duration="180">
                        <TransitionNumberCondition inputId="0:11" opValue="lessThan" value="1"/>
                    </StateTransition>
                    <StateTransition stateToId="0:22" duration="180">
                        <TransitionNumberCondition inputId="0:11" opValue="greaterThanOrEqual" value="1"/>
                        <TransitionNumberCondition inputId="0:11" opValue="lessThan" value="2"/>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>

            <!-- Layer 2: Tactile 3D Press Depression -->
            <StateMachineLayer name="PressLayer" id="0:25">
                <AnyState x="200" y="-120"/>
                <ExitState x="620" y="-120"/>
                <EntryState>
                    <StateTransition stateToId="0:26"/>
                </EntryState>

                <AnimationState x="200" y="40" animationId="0:33" id="0:26">
                    <StateTransition stateToId="0:27" duration="80">
                        <TransitionBoolCondition inputId="0:12" opValue="equal"/>
                    </StateTransition>
                </AnimationState>

                <AnimationState x="420" y="40" animationId="0:34" id="0:27">
                    <StateTransition stateToId="0:26" duration="100">
                        <TransitionBoolCondition inputId="0:12" opValue="notEqual"/>
                    </StateTransition>
                </AnimationState>
            </StateMachineLayer>
        </StateMachine>

        <!-- 0:30 StatusLocked -->
        <LinearAnimation duration="10" loopValue="oneShot" name="StatusLocked" id="0:30">
            <KeyedObject objectId="0:121"><KeyedProperty propertyKey="37"><KeyFrameColor value="FFCBD5E1" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="0:131"><KeyedProperty propertyKey="37"><KeyFrameColor value="FF94A3B8" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject>
