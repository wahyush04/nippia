                <KeyedProperty propertyKey="17">
                    <KeyFrameDouble value="0.82" frame="0" interpolationType="cubic"><CubicEaseInterpolator x1="0.2" y1="0" x2="0.4" y2="1"/></KeyFrameDouble>
                    <KeyFrameDouble value="1.22" frame="90" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>

        <!-- 0:32 StatusCompleted (gold badge with check) -->
        <LinearAnimation duration="120" loopValue="loop" name="StatusCompleted" id="0:32">
            <KeyedObject objectId="0:121"><KeyedProperty propertyKey="37"><KeyFrameColor value="FFFBBF24" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="0:131"><KeyedProperty propertyKey="37"><KeyFrameColor value="FFD97706" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="0:140"><KeyedProperty propertyKey="18"><KeyFrameDouble value="0.0" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject>
