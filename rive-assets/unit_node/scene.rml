        <!-- 0:31 StatusActive (1.5s pulsing emerald beacon = 90f) -->
        <LinearAnimation duration="90" loopValue="loop" name="StatusActive" id="0:31">
            <KeyedObject objectId="0:121"><KeyedProperty propertyKey="37"><KeyFrameColor value="FF10B981" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="0:131"><KeyedProperty propertyKey="37"><KeyFrameColor value="FF059669" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="0:140"><KeyedProperty propertyKey="18"><KeyFrameDouble value="0.0" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="0:150"><KeyedProperty propertyKey="18"><KeyFrameDouble value="1.0" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="0:160"><KeyedProperty propertyKey="18"><KeyFrameDouble value="0.0" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject>
            <KeyedObject objectId="0:170">
                <KeyedProperty propertyKey="18">
