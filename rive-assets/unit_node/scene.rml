        <!-- 0:33 CapReleased -->
        <LinearAnimation duration="10" loopValue="oneShot" name="CapReleased" id="0:33">
            <KeyedObject objectId="0:120"><KeyedProperty propertyKey="14"><KeyFrameDouble value="116" frame="0" interpolationType="hold"/></KeyedProperty></KeyedObject>
        </LinearAnimation>

        <!-- 0:34 CapPressed -->
        <LinearAnimation duration="10" loopValue="oneShot" name="CapPressed" id="0:34">
