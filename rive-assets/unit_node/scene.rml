        </LinearAnimation>

        <!-- Artwork (front-to-back) -->
        <!-- Tactile Cap Group (shifts down when pressed) -->
        <Node x="128" y="116" name="NodeCapGroup" id="0:120">
            <!-- Lock Glyph (Status 0) -->
            <Node x="0" y="2" name="LockGlyph" id="0:140">
                <Shape x="0" y="-14" name="Shackle">
                    <Rectangle width="28" height="28" cornerRadiusTL="14" originX="0.5" originY="0.5" name="Path"/>
                    <Stroke thickness="7" name="Stroke"><SolidColor colorValue="FF64748B" name="Slate"/></Stroke>
                </Shape>
                <Shape x="0" y="8" name="LockBody">
                    <Rectangle width="44" height="34" cornerRadiusTL="8" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FF64748B" name="Slate"/></Fill>
                </Shape>
            </Node>

            <!-- Active Star Glyph (Status 1) -->
            <Node x="0" y="0" opacity="0" name="ActiveStarGlyph" id="0:150">
                <Shape x="0" y="0" name="Star">
                    <Star width="64" height="64" points="5" innerRadius="0.48" cornerRadius="4" originX="0.5" originY="0.5" name="Path"/>
                    <Fill name="Fill"><SolidColor colorValue="FFFFFFFF" name="White"/></Fill>
                </Shape>
            </Node>

            <!-- Completed Check Glyph (Status 2) -->
            <Node x="0" y="0" opacity="0" name="CheckGlyph" id="0:160">
                <Shape x="0" y="2" name="CheckMark">
                    <PointsPath isClosed="false" name="Path">
                        <StraightVertex x="-24" y="2"/>
                        <StraightVertex x="-6" y="20"/>
                        <StraightVertex x="26" y="-18"/>
                    </PointsPath>
                    <Stroke thickness="12" cap="round" join="round" name="Check"><SolidColor colorValue="FFFFFFFF" name="White"/></Stroke>
                </Shape>
            </Node>

            <!-- Cap Specular Shine -->
            <Shape x="-32" y="-36" rotation="-0.5" name="CapShine">
                <Ellipse width="32" height="14" originX="0.5" originY="0.5" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="44FFFFFF" name="Shine"/></Fill>
            </Shape>

            <!-- Cap Surface -->
            <Shape x="0" y="0" name="CapDisc">
                <Ellipse width="152" height="132" originX="0.5" originY="0.5" name="Path"/>
                <Fill name="Fill"><SolidColor colorValue="FFCBD5E1" name="CapColor" id="0:121"/></Fill>
                <Stroke thickness="4" name="Border"><SolidColor colorValue="33FFFFFF" name="Highlight"/></Stroke>
            </Shape>
        </Node>

        <!-- 3D Extruded Bottom Ledge -->
        <Shape x="128" y="132" name="NodeLedge" id="0:130">
            <Ellipse width="152" height="132" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill"><SolidColor colorValue="FF94A3B8" name="LedgeColor" id="0:131"/></Fill>
