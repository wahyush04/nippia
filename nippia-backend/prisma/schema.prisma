generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  USER
  ADMIN
}

enum DailyGoal {
  SANTAI
  REGULER
  AMBISIUS
}

enum CategoryCode {
  TWK
  TIU
  TKP
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum QuestionType {
  MULTIPLE_CHOICE
  WEIGHTED_SCALE
}

enum OptionLabel {
  A
  B
  C
  D
  E
}

enum UnitProgressStatus {
  LOCKED
  ACTIVE
  COMPLETED
}

enum TryoutType {
  MINI_CAT
  FULL_CAT
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  GRACE_PERIOD
  CANCELED
}

enum LeagueTier {
  BRONZE
  SILVER
  GOLD
  SAPPHIRE
  DIAMOND
}

// ============================================================================
// AUTHENTICATION & USERS
// ============================================================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String?   @unique
  googleId      String?   @unique @map("google_id")
  displayName   String?   @map("display_name")
  avatarUrl     String?   @map("avatar_url")
  role          UserRole  @default(USER)
  isGuest       Boolean   @default(false) @map("is_guest")
  dailyGoal     DailyGoal @default(REGULER) @map("daily_goal")
  dailyXpTarget Int       @default(50) @map("daily_xp_target")
  fcmToken      String?   @map("fcm_token")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  gamification       UserGamification?
  refreshTokens      RefreshToken[]
  unitProgresses     UserUnitProgress[]
  mistakes           UserMistake[]
  subscriptions      Subscription[]
  tryoutAttempts     TryoutAttempt[]
  idempotencyRecords IdempotencyRecord[]

  @@index([updatedAt])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================================
// LEARNING CONTENT (DYNAMIC OTA DELTA SYNC & LIFECYCLE)
// ============================================================================

model Category {
  id           String       @id @default(uuid()) @db.Uuid
  code         CategoryCode @unique
  name         String
  passingGrade Int          @map("passing_grade")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  units Unit[]

  @@index([updatedAt])
  @@map("categories")
}

model Unit {
  id            String        @id @default(uuid()) @db.Uuid
  categoryId    String        @map("category_id") @db.Uuid
  sectionTitle  String        @map("section_title")
  orderIndex    Int           @map("order_index")
  title         String
  subTopic      String?       @map("sub_topic")
  guideMarkdown String        @map("guide_markdown") @db.Text
  xpReward      Int           @default(20) @map("xp_reward")
  isProOnly     Boolean       @default(false) @map("is_pro_only")
  status        ContentStatus @default(DRAFT)
  version       Int           @default(1)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  category       Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  questions      Question[]
  userProgresses UserUnitProgress[]

  @@unique([categoryId, orderIndex])
  @@index([categoryId, status])
  @@index([updatedAt])
  @@map("units")
}

model Question {
  id           String        @id @default(uuid()) @db.Uuid
  unitId       String?       @map("unit_id") @db.Uuid
  categoryCode CategoryCode  @map("category_code")
  subTopic     String        @map("sub_topic")
  type         QuestionType
  orderIndex   Int           @default(0) @map("order_index")
  contentText  String        @map("content_text") @db.Text
  imageUrl     String?       @map("image_url")
  explanation  String        @db.Text
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  unit            Unit?                   @relation(fields: [unitId], references: [id], onDelete: SetNull)
  options         QuestionOption[]
  mistakes        UserMistake[]
  tryoutQuestions TryoutPackageQuestion[]

  @@index([unitId, status])
  @@index([categoryCode, subTopic])
  @@index([updatedAt])
  @@map("questions")
}

model QuestionOption {
  id         String      @id @default(uuid()) @db.Uuid
  questionId String      @map("question_id") @db.Uuid
  label      OptionLabel
  optionText String      @map("option_text") @db.Text
  imageUrl   String?     @map("image_url")
  score      Int // 0 or 5 for TWK/TIU; 1..5 for TKP

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, label])
  @@index([questionId])
  @@map("question_options")
}

// ============================================================================
// USER PROGRESS, MISTAKES & GAMIFICATION
// ============================================================================

model UserUnitProgress {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  unitId        String             @map("unit_id") @db.Uuid
  status        UnitProgressStatus @default(LOCKED)
  bestScore     Int                @default(0) @map("best_score")
  attemptsCount Int                @default(0) @map("attempts_count")
  completedAt   DateTime?          @map("completed_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([userId, unitId])
  @@index([userId])
  @@index([updatedAt])
  @@map("user_unit_progress")
}

model UserMistake {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  wrongCount Int      @default(1) @map("wrong_count")
  isResolved Boolean  @default(false) @map("is_resolved")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([userId, isResolved])
  @@index([updatedAt])
  @@map("user_mistakes")
}

model UserGamification {
  userId           String     @id @map("user_id") @db.Uuid
  totalXp          Int        @default(0) @map("total_xp")
  weeklyXp         Int        @default(0) @map("weekly_xp")
  gems             Int        @default(0)
  currentStreak    Int        @default(0) @map("current_streak")
  longestStreak    Int        @default(0) @map("longest_streak")
  streakFreezes    Int        @default(0) @map("streak_freezes")
  hearts           Int        @default(5)
  lastHeartRegenAt DateTime?  @map("last_heart_regen_at")
  lastActiveDate   DateTime?  @map("last_active_date") @db.Date
  leagueTier       LeagueTier @default(BRONZE) @map("league_tier")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([updatedAt])
  @@map("user_gamification")
}

model IdempotencyRecord {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  endpoint       String
  idempotencyKey String   @map("idempotency_key")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint, idempotencyKey])
  @@index([userId])
  @@map("idempotency_records")
}

// ============================================================================
// MONETIZATION & CAT TRYOUT SIMULATIONS
// ============================================================================

model Subscription {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  productId     String             @map("product_id")
  purchaseToken String             @unique @map("purchase_token")
  status        SubscriptionStatus
  isTrial       Boolean            @default(false) @map("is_trial")
  expiryTime    DateTime           @map("expiry_time")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([updatedAt])
  @@map("subscriptions")
}

model TryoutPackage {
  id              String        @id @default(uuid()) @db.Uuid
  title           String
  description     String?       @db.Text
  type            TryoutType
  durationMinutes Int           @map("duration_minutes")
  totalQuestions  Int           @map("total_questions")
  isProOnly       Boolean       @default(false) @map("is_pro_only")
  status          ContentStatus @default(DRAFT)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  questions TryoutPackageQuestion[]
  attempts  TryoutAttempt[]

  @@index([status])
  @@index([updatedAt])
  @@map("tryout_packages")
}

model TryoutPackageQuestion {
  id         String @id @default(uuid()) @db.Uuid
  packageId  String @map("package_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  orderIndex Int    @map("order_index")

  package  TryoutPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  question Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([packageId, questionId])
  @@unique([packageId, orderIndex])
  @@index([packageId])
  @@map("tryout_package_questions")
}

model TryoutAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  packageId   String    @map("package_id") @db.Uuid
  startedAt   DateTime  @default(now()) @map("started_at")
  expiresAt   DateTime  @map("expires_at")
  submittedAt DateTime? @map("submitted_at")
  twkScore    Int       @default(0) @map("twk_score")
  tiuScore    Int       @default(0) @map("tiu_score")
  tkpScore    Int       @default(0) @map("tkp_score")
  totalScore  Int       @default(0) @map("total_score")
  isPassed    Boolean   @default(false) @map("is_passed")
  answersJson Json?     @map("answers_json")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  package TryoutPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([packageId])
  @@index([updatedAt])
  @@map("tryout_attempts")
}
