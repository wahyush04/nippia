NODE_ENV=development
PORT=3000

# PostgreSQL & Redis (sesuai docker-compose.yml)
DATABASE_URL="postgresql://nippia:nippia_secret@localhost:5432/nippia_db"
REDIS_URL="redis://localhost:6379"

# JWT Secrets (ganti dengan secret acak minimal 32 karakter di production)
JWT_ACCESS_SECRET="dev_access_secret_change_me_min_32_chars"
JWT_REFRESH_SECRET="dev_refresh_secret_change_me_min_32_chars"
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_DAYS=30

# Google Sign-In
GOOGLE_CLIENT_ID=""

# Cloudflare R2 / S3
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="nippia-media"
R2_PUBLIC_URL=""

# Firebase Cloud Messaging (opsional di dev)
FIREBASE_SERVICE_ACCOUNT_JSON=""
